{
  "name": "@folotoy/folotoy-openclaw-installer",
  "version": "0.8.0",
  "description": "Interactive installer + preset CLI for the FoloToy OpenClaw plugin.",
  "keywords": [
    "folotoy",
    "openclaw",
    "installer"
  ],
  "homepage": "https://github.com/FoloToy/folotoy-openclaw-plugin#readme",
  "bugs": {
    "url": "https://github.com/FoloToy/folotoy-openclaw-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoloToy/folotoy-openclaw-plugin.git",
    "directory": "installer"
  },
  "license": "MIT",
  "author": "Larry Wang",
  "type": "module",
  "bin": {
    "folotoy-openclaw-installer": "./bin/folotoy.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src/cli",
    "src/presets"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "folotoy": {
    "runtimePackage": "@folotoy/folotoy-openclaw-plugin"
  }
}
